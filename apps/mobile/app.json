{
  "expo": {
    "name": "CheluisFIT",
    "slug": "cheluisfit",
    "scheme": "cheluisfit",
    "version": "0.11.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F0E0D",
    "android": {
      "package": "com.redgarverde.cheluisfit",
      "versionCode": 1100,
      "adaptiveIcon": {
        "backgroundColor": "#0F0E0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_EXERCISE_ROUTE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_ELEVATION_GAINED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0F0E0D"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CheluisFIT usa la cámara para escanear códigos de barras de alimentos."
        }
      ],
      "expo-video",
      "expo-system-ui",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF5B2E"
        }
      ],
      "./plugins/withReleaseSigning.js",
      "./plugins/withReleaseArchitecture.js",
      "./plugins/withReleaseOptimizations.js",
      "expo-secure-store",
      "react-native-health-connect",
      "./plugins/withHealthConnectDelegate.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-web-browser",
      "expo-sharing"
    ]
  }
}
