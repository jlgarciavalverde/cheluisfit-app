APP_VERSION=0.1.0
NODE_ENV=production
ALLOWED_ORIGINS=https://cheluisfit.redgarverde.com
# Código de un solo uso para crear la primera cuenta (admin) desde la app. Cámbialo por uno tuyo
# y bórralo del .env real una vez creada la cuenta si quieres cerrar el registro del todo.
SETUP_CODE=cambia-esto
LOG_LEVEL=info
# Asistente de IA (opcional): sin ninguna de las dos, el botón del asistente no aparece en la
# app. Claves gratuitas, sin tarjeta: Gemini en https://aistudio.google.com/apikey, Groq en
# https://console.groq.com/keys. Con las dos, Gemini es el principal y Groq el respaldo si falla.
GEMINI_API_KEY=
GROQ_API_KEY=
# Strava (opcional): recorrido GPS de las carreras, ya que Garmin nunca lo comparte por Health
# Connect. Regístrala en https://www.strava.com/settings/api ("dominio de callback de
# autorización" = cheluisfit.redgarverde.com, sin https:// ni ruta) — no hace falta revisión de
# Strava mientras tenga menos de 10 atletas conectados ("modo un solo jugador"). Sin estas dos,
# el botón «Conectar Strava» de la app da un aviso claro, no un fallo.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
